{
    "name": "vue-family-bucket",
    "type": "module",
    "version": "0.0.0",
    "private": true,
    "author": {
        "name": "zhw",
        "email": "947201280@qq.com",
        "url": "https://blog.csdn.net/weixin_44224921"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zhw-pig/vue-family-bucket.git"
    },
    "bugs": {
        "url": "https://github.com/zhw-pig/vue-family-bucket/issues"
    },
    "engines": {
        "node": "^22 || >=18"
    },
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc -b && vite build",
        "build:prod": "vite build --mode production",
        "preview": "vite preview",
        "lint:eslint": "eslint . --ext .vue,.ts,.js,.jsx,.mjs --fix",
        "lint:stylelint": "stylelint src/**/*.{css,scss,vue} --fix",
        "batch:prettier": "prettier --write  \"src/**/*.{js,json,tsx,css,less,scss,vue,html,md}\"",
        "prepare": "husky  install",
        "preinstall": "npx only-allow pnpm",
        "clean:cache": "rimraf node_modules/.cache/ && rimraf node_modules/.vite",
        "clean:lib": "rimraf node_modules"
    },
    "dependencies": {
        "@ant-design/icons-vue": "^7.0.1",
        "@vueuse/core": "^13.1.0",
        "ant-design-vue": "^4.2.6",
        "axios": "^1.9.0",
        "colorthief": "^2.6.0",
        "html2canvas": "^1.4.1",
        "jspdf": "^3.0.1",
        "pinia": "^3.0.2",
        "vue": "^3.5.13",
        "vue-router": "^4.5.1"
    },
    "devDependencies": {
        "@antfu/eslint-config": "^4.13.2",
        "@commitlint/cli": "^19.8.1",
        "@commitlint/config-conventional": "^19.8.1",
        "@types/node": "^22.15.21",
        "@typescript-eslint/eslint-plugin": "^8.32.1",
        "@typescript-eslint/parser": "^8.32.1",
        "@vitejs/plugin-vue": "^5.2.2",
        "@vue/tsconfig": "^0.7.0",
        "globals": "^16.2.0",
        "husky": "^8.0.3",
        "less": "^4.3.0",
        "lint-staged": "^16.0.0",
        "postcss": "^8.5.3",
        "postcss-html": "^1.8.0",
        "postcss-less": "^6.0.0",
        "prettier": "^3.5.3",
        "stylelint": "^16.19.1",
        "stylelint-config-html": "^1.1.0",
        "stylelint-config-recommended": "^16.0.0",
        "stylelint-config-recommended-less": "^3.0.1",
        "stylelint-config-recommended-vue": "^1.6.0",
        "stylelint-config-standard": "^38.0.0",
        "stylelint-config-standard-less": "^3.0.1",
        "stylelint-order": "^7.0.0",
        "stylelint-prettier": "^5.0.3",
        "typescript": "~5.7.3",
        "unplugin-auto-import": "^19.3.0",
        "unplugin-vue-components": "^28.7.0",
        "vite": "^6.3.5",
        "vite-plugin-progress": "^0.0.7",
        "vue-tsc": "^2.2.10"
    },
    "lint-staged": {
        "*.{js,jsx,vue,md,json}": [
            "npm run batch:prettier",
            "npm run lint:eslint",
            "npm run lint:stylelint"
        ]
    }
}
